# Copy to .env and fill in. Never commit .env.

# development | production
APP_ENV=development
PORT=8080

# Either a single connection string (Render, Neon, Supabase give you one)…
# DATABASE_URL=postgres://user:password@host:5432/fooddash?sslmode=require
# …or the individual settings below (ignored when DATABASE_URL is set).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=fooddash
# Use "require" for managed databases (Render, Supabase, Neon...)
DB_SSLMODE=disable

# Required in production, min 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_HOURS=24

# Code staff enter to create a staff account. Leave empty to disable staff sign-up.
STAFF_CODE=

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# IPs/CIDRs of your reverse proxy/load balancer, so client IPs (rate limiting, logs) are correct
TRUSTED_PROXIES=
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- Business settings ----
TIMEZONE=Africa/Lagos
# Orders are only accepted between these times. Set both equal for 24 hours.
OPENING_TIME=08:00
CLOSING_TIME=22:00
# VAT added on top of food (not delivery). Set 0 if your menu prices already include VAT.
VAT_PERCENT=7.5
MIN_ORDER_NAIRA=0

# ---- Paystack (optional) ----
# Without a key, customers can only pay on delivery/pickup.
# Test keys start with sk_test_. Set the webhook URL in the Paystack dashboard to
# https://<your-api-domain>/api/v1/webhooks/paystack
PAYSTACK_SECRET_KEY=
# Where Paystack sends the customer after paying (a frontend page that calls GET /payments/verify)
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback

# ---- Website & email ----
# Public address of the website (used for links in emails)
APP_URL=http://localhost:5173
# SMTP for password-reset emails. Leave SMTP_HOST empty in development:
# the reset link is printed in the API terminal instead.
# Examples: smtp.gmail.com (587, use an App Password), smtp.zoho.com (465),
# smtp-relay.brevo.com (587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Cravely <no-reply@yourdomain.com>
